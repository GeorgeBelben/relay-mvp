[Unit]
Description=Relay kiosk (cage + Relay app)
Documentation=man:cage(1)
Conflicts=getty@tty1.service
After=getty@tty1.service systemd-user-sessions.service plymouth-quit-wait.service
Wants=plymouth-quit-wait.service

[Service]
Type=simple
User=relay
Environment=XCURSOR_THEME=relay-blank
Environment=XCURSOR_SIZE=24
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# Nothing else calls this: we Conflicts= getty@tty1 (the usual thing that triggers plymouth's
# quit on a normal boot), and there's no display manager either. --retain-splash quits the daemon
# without hiding the splash frame first, so the last frame stays on screen (no black flash) until
# cage paints over it, instead of the splash hanging forever.
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/bin/cage -- /usr/bin/relay-gui
Restart=always
RestartSec=2
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
