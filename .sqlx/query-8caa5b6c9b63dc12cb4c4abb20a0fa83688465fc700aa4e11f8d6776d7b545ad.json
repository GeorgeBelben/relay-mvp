  "db_name": "SQLite",
  "query": "INSERT INTO roms (id, system_id, path, crc32, md5, size_bytes, discs, status, created_at, updated_at)\n           VALUES (?, ?, ?, ?, ?, ?, ?, 'ok', ?, ?)\n           ON CONFLICT (path) DO UPDATE SET\n             crc32 = excluded.crc32,\n             md5 = excluded.md5,\n             size_bytes = excluded.size_bytes,\n             discs = excluded.discs,\n             status = 'ok',\n             updated_at = excluded.updated_at\n           RETURNING id, system_id, path, crc32, md5, size_bytes, discs, status,\n                     created_at as \"created_at!: i64\", updated_at as \"updated_at!: i64\"",
